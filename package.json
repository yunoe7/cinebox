{
  "name": "cinebox",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:cf": "npm run build && wrangler pages dev out --port 3000 --compatibility-date=2024-01-01",
    "build": "next build && node scripts/generate-csp.mjs",
    "start": "wrangler pages dev out --port 3000 --compatibility-date=2024-01-01",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test",
    "test:e2e": "playwright test",
    "test:integration": "playwright test --config=playwright.integration.config.ts",
    "test:csp": "playwright test --config=playwright.csp.config.ts",
    "check:csp": "node scripts/check-csp.mjs",
    "hash:admin": "node scripts/hash-admin-password.mjs"
  },
  "dependencies": {
    "framer-motion": "^12.23.12",
    "lucide-react": "^0.468.0",
    "next": "^15.5.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.7",
    "fake-indexeddb": "^6.2.7",
    "typescript": "^5.8.3",
    "wrangler": "4.158.0"
  },
  "overrides": {
    "postcss": "8.5.32"
  }
}
