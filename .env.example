# CinéBox — variables d'environnement
#
# Copier ce fichier vers .env.local pour le développement Next.js.
# Pour les Cloudflare Pages Functions, utiliser .dev.vars (ignoré par Git)
# ou les variables/bindings du projet Cloudflare Pages.
#
# Ne jamais versionner de vrai secret. Les variables non préfixées NEXT_PUBLIC_
# restent côté serveur.

# TMDB — jeton Read Access (v4) ou clé API v3.
# Utilisé uniquement par functions/api/tmdb/[[path]].ts.
TMDB_READ_ACCESS_TOKEN=

# Administration — identifiant Discord autorisé à administrer CinéBox.
# Renseigner ton identifiant utilisateur Discord (17 à 20 chiffres).
# Les comptes avec role=admin ou présents dans admin_allowlist sont aussi autorisés.
CINEBOX_ADMIN_DISCORD_USER_ID=

# Autorisation automatique de l'administration via les rôles du serveur Discord.
# Créer/activer un bot sur le serveur, activer l'intent Server Members et conserver son token côté serveur.
# Renseigner les IDs numériques du serveur et des rôles (Fonda, Admin, Modo).
CINEBOX_DISCORD_BOT_TOKEN=
CINEBOX_DISCORD_GUILD_ID=
CINEBOX_DISCORD_ROLE_FONDA_ID=
CINEBOX_DISCORD_ROLE_ADMIN_ID=
CINEBOX_DISCORD_ROLE_MODO_ID=

# Discord OAuth - connexion obligatoire à CinéBox (adhésion au serveur facultative).
# Déclarer la même URL de callback dans le portail développeur Discord.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=

# D1 : le binding Cloudflare doit s'appeler "DB".
# Il se configure dans le tableau de bord Pages (Settings > Functions > D1)
# ou dans un wrangler.toml local non versionné (voir wrangler.toml.example).
